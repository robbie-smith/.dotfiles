# Login shell is brew bash, so ~/.bash_profile is what actually gets read.
# This file exists for the shells that read ~/.profile instead (sh, and any
# tool that spawns a POSIX login shell) -- it just hands off to bash_profile.
#
# Keep this POSIX sh. No [[ ]], no bashisms; ~/.profile is not always bash.

. "$HOME/.cargo/env"

if [ -f "$HOME/.bash_profile" ]; then
    . "$HOME/.bash_profile"
fi
