# Brewfile.personal -- Foundry24 / personal machine
#
# Layered on top of Brewfile.  Run:  ./install.sh personal

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
brew "awscli"
cask "session-manager-plugin"
cask "gcloud-cli"            # mise also pins a gcloud version in ~/.config/mise/config.toml

# ---------------------------------------------------------------------------
# Databases / geo
# ---------------------------------------------------------------------------
brew "pgcli"
brew "postgis"
brew "gdal"
cask "postgres-app"          # was "postgres-unofficial"; brew renamed it

# ---------------------------------------------------------------------------
# iOS / mobile
#
# Xcode itself cannot go here -- there is no cask for it. `xcodes` below is the
# closest this file gets: it downloads and selects Xcode from one command, so a
# new machine needs no App Store detour. See REPLICATE.md for the full sequence
# (installing Xcode.app is only step one; the simulator runtimes are separate).
#
# Signing also needs the ios-certificates match repo and the App Store Connect
# API key, neither of which is in any repo. See REPLICATE.md.
# ---------------------------------------------------------------------------
brew "fastlane"
brew "cocoapods"
brew "xcodegen"
brew "xcodes"                # installs/selects Xcode itself; see REPLICATE.md

# Maestro (UI test automation) ships from mobile.dev's own tap, NOT core. Do not
# shorten this to `cask "maestro"` -- that name belongs to an unrelated 682MB
# runmaestro.ai GUI app, which is what used to be here. It bundled cleanly while
# leaving no `maestro` on PATH, so the breakage looked like a missing install.
#
# Keep the formula fully qualified. If the bare-name cask is ever installed
# alongside it, Homebrew refuses to auto-link this one ("maestro cask is
# installed, skipping link") and only an explicit `brew link maestro` fixes it.
#
# The formula declares `depends_on openjdk 17+`, but only symlinks the launcher --
# it never points JAVA_HOME at that keg, and brew keeps openjdk keg-only. So the
# openjdk brew drags in here is inert, and maestro's JVM comes from mise instead:
# its launcher is a stock Gradle script that takes $JAVA_HOME, else `java` on PATH.
#
# Consequence: maestro only runs where mise is activated. In a plain `#!/bin/sh`
# script, cron, CI, or a fastlane/Xcode build phase that skips the login shell,
# `java` falls through to the /usr/bin/java stub and maestro dies with
# "Unable to locate a Java Runtime" -- which never mentions mise. Fix is to
# activate mise (or export JAVA_HOME=$(mise where java)) in that context, not to
# install another JDK.
tap "mobile-dev-inc/tap"
brew "mobile-dev-inc/tap/maestro"

# ---------------------------------------------------------------------------
# Personal GUI
# ---------------------------------------------------------------------------
cask "spotify"
cask "protonvpn"
cask "charles"
cask "chatgpt"
cask "claude"
cask "superkey"
cask "multitouch"
cask "logi-options+"         # was "logi-options-plus"; brew renamed it
cask "wispr-flow"

# ---------------------------------------------------------------------------
# Go tools
# ---------------------------------------------------------------------------
go "github.com/wailsapp/wails/v2/cmd/wails"   # foundry/desktop-apps/* are Wails apps

# ---------------------------------------------------------------------------
# Global npm packages
#
# @foundry24/cdk-app-patterns is deliberately NOT listed here. It's published to
# GitHub Packages rather than npmjs (source: github.com/Foundry24/cdk-app-patterns),
# so it 401s until ~/.npmrc carries a PAT:
#
#   @foundry24:registry=https://npm.pkg.github.com
#   //npm.pkg.github.com/:_authToken=<GitHub PAT with read:packages>
#
# That's a manual step, so listing it here would fail the bundle on a fresh
# machine. Install it after setting up ~/.npmrc -- see REPLICATE.md.
# ---------------------------------------------------------------------------
npm "aws-cdk"
npm "tailwindcss"
npm "@redocly/cli"
npm "@google/gemini-cli"
npm "clawhub"
npm "server"
